# Toggle provider in lib/chatbot/config.ts (default: gemini)

# Google Gemini (default provider)
GEMINI_API_KEY=
# Optional: override model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI ChatGPT (set CHAT_MODEL_PROVIDER=openai in lib/chatbot/config.ts)
OPENAI_API_KEY=
# Optional: override model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
